# Google OAuth Configuration
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/callback"

# App & Session Settings
FRONTEND_URL="http://localhost:3000"
SESSION_SECRET="your-secure-random-session-secret-key-here"

# ---------------------------------------------------------------------------
# Task Queue (Redis)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# ---------------------------------------------------------------------------
# Vector Database (ChromaDB — running in Docker)
# ---------------------------------------------------------------------------
CHROMA_HOST="localhost"
CHROMA_PORT="8001"

# ---------------------------------------------------------------------------
# Relational Database (NeonDB / PostgreSQL)
# ---------------------------------------------------------------------------
NEON_DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?ssl=require"

# ---------------------------------------------------------------------------
# NVIDIA Cloud API (Embeddings + LLM)
# Get your key from: https://build.nvidia.com/
# ---------------------------------------------------------------------------
NVIDIA_API_KEY="nvapi-xxxxxxxxxxxxxxxxxxxx"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_EMBED_MODEL="nvidia/nv-embedqa-e5-v5"
NVIDIA_LLM_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# ---------------------------------------------------------------------------
# Reranking (also via NVIDIA or a separate endpoint)
# ---------------------------------------------------------------------------
RERANK_API_URL="https://integrate.api.nvidia.com/v1"
RERANK_API_KEY="nvapi-xxxxxxxxxxxxxxxxxxxx"
RERANK_MODEL="nvidia/nv-rerankqa-mistral-4b-v3"

# ---------------------------------------------------------------------------
# RAG Tuning
# ---------------------------------------------------------------------------
CHUNK_SIZE="1500"
CHUNK_OVERLAP="400"
RAG_TOP_K="10"
RAG_RERANK_TOP_N="5"
