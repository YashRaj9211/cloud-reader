meta {
  name: Exchange Token / Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/token
  body: json
  auth: none
}

body:json {
  {
    "access_token": "",
    "code": "",
    "redirect_uri": ""
  }
}

script:post-response {
  if (res.body && res.body.session_token) {
    bru.setEnvVar("token", res.body.session_token);
  }
}
